# background_image ~/dotfiles/wallpapers/wallhaven-l82kpr.png
# background_image_layout cscaled
# background_image_linear yes
# background_tint 1
exe_search_path +/opt/homebrew/bin/fish
shell /opt/homebrew/bin/fish --login --interactive
editor nvim
background_blur 0
background_opacity 0.95

# transparent_background_colors #181c2c@0.96 #001f00@0.90 #240500@0.90 #103610@0.92 #730000@0.90 #3B4261@0.96

font_size 17.5
font_family      "CommitMono Nerd Font"
bold_font        "CommitMono Nerd Font Bold"
italic_font      "CommitMono Nerd Font Italic"
bold_italic_font "CommitMono Nerd Font Bold Italic"
modify_font cell_height 1
modify_font cell_width 96%

# https://beuke.org/terminal-latency/
# 150 FPS
repaint_delay 8
# Remove artificial input delay
input_delay 0
# turn off vsync
sync_to_monitor no

text_composition_strategy 1.0 0.5
inactive_text_alpha 0.75
clipboard_control write-clipboard write-primary no-append
disable_ligatures cursor

tab_bar_edge top
tab_bar_style powerline
tab_bar_min_tabs 1
tab_bar_filter session:~ or session:^$

# Stop kitty shell-integration from changing window/tab titles based on the running command
# This is so that when I open Neovim I don't see that as the tab name
shell_integration no-title

enabled_layouts splits

cursor_blink_interval -1
cursor_shape beam
cursor_trail 20
cursor_trail_decay 0.01 0.5
cursor_trail_start_threshold 0

confirm_os_window_close 0
enable_audio_bell no
allow_remote_control yes
copy_on_select yes
url_style double
window_padding_width 1 5 2 2
window_border_width 4px
active_border_color #ff0000
hide_window_decorations yes
initial_window_height 400
initial_window_width 640
single_window_margin_width 0
placement_strategy center
scrollback_lines 50000
remember_window_position true

# macOS stuff
macos_option_as_alt                left
macos_quit_when_last_window_closed yes
macos_show_window_title_in         none
macos_custom_beam_cursor           yes
macos_titlebar_color background
term xterm-kitty

# Remove all shortcut definitions up to this point.
# Useful, for instance, to remove the default shortcuts.
clear_all_shortcuts yes

kitty_mod cmd

map kitty_mod+v paste_from_clipboard
map kitty_mod+c copy_to_clipboard
map kitty_mod+r send_text all \x1b\x5b\x41\x0a
map kitty_mod+opt+s noop
map kitty_mod+shift+q quit

# brightness controls
map kitty_mod+b>l set_background_opacity +0.01
map kitty_mod+b>h set_background_opacity -0.01
map kitty_mod+b>1 set_background_opacity 1
map kitty_mod+b>r set_background_opacity default

map ctrl+j kitten pass_keys.py bottom ctrl+j "nvim"
map ctrl+k kitten pass_keys.py top    ctrl+k "nvim"
map ctrl+h kitten pass_keys.py left   ctrl+h "nvim"
map ctrl+l kitten pass_keys.py right  ctrl+l "nvim"

map kitty_mod+u scroll_page_up
map kitty_mod+d scroll_page_down
map --allow-fallback=shifted,ascii kitty_mod+up scroll_to_prompt -1
map --allow-fallback=shifted,ascii kitty_mod+down scroll_to_prompt 1

map kitty_mod+shift+,   load_config_file
map kitty_mod+w         close_window
map kitty_mod+e         launch --cwd=current --location=vsplit
map kitty_mod+shift+e   launch --cwd=current --location=hsplit

map kitty_mod+k launch --type=background /opt/homebrew/bin/fish '$HOME/dotfiles/kitty/sesh.fish'
map kitty_mod+0x27 goto_session -1
map kitty_mod+t new_tab_with_cwd

map ctrl+b>d goto_session $HOME/github/dotfiles-latest/kitty/sessions/dotfiles.kitty-session

action_alias update_kitty_name launch --type=background /bin/zsh -c '"$HOME/github/dotfiles-latest/sketchybar/felixkratz-linkarzu/plugins/kitty_name.sh"'


